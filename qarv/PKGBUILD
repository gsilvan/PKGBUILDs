# Maintainer: Jure Varlec <jure.varlec@ad-vega.si>
# Contributor: Silvan Gümüsdere <silvan@trollbox.org>

pkgname=qarv
pkgver=3.1.1
pkgrel=1
pkgdesc="Qt GUI and API interfaces to ethernet cameras via Aravis"
arch=(
  'i686'
  'x86_64'
  'aarch64'
)
url="https://github.com/AD-Vega/${pkgname}"
license=('GPL-3.0-or-later')
depends=(
  'qt5-base'
  'qt5-svg'
  'aravis<0.9'
  'ffmpeg'
  'opencv'
  'gstreamer'
)
makedepends=(
  'cmake'
  'qt5-tools'
  'doxygen'
  'graphviz'
)
provides=('qarv')
conflicts=('qarv-git')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/AD-Vega/${pkgname}/archive/${pkgver}.tar.gz"
)
sha256sums=(
  '7b3284bb17ed7c778d6ca95413866e75ffb12f1ae58b77b943072df3983cbd7f'
)

build() {
  local cmake_options=(
    -B build
    -S "$pkgname-$pkgver"
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build --target all doc
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -d "$pkgdir/usr/share/doc/$pkgname/apidoc"
  cp -a build/apidoc/. "$pkgdir/usr/share/doc/$pkgname/apidoc/"
  cd $pkgname-$pkgver
  install -Dm644 README NEWS AUTHORS -t "$pkgdir/usr/share/doc/$pkgname"
}

