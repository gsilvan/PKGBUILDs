# Maintainer: Jure Varlec <jure.varlec@ad-vega.si>
# Contributor: Silvan Gümüsdere <silvan@trollbox.org>

pkgname=qarv
pkgver=3.1.0
pkgrel=1
pkgdesc="Qt GUI and API interfaces to ethernet cameras via Aravis"
arch=(
  'i686'
  'x86_64'
)
url="https://github.com/AD-Vega/${pkgname}"
license=('GPL-3.0-or-later')
depends=(
  'qt5-base'
  'qt5-svg'
  'qt5-tools'
  'aravis<=0.8.35'
  'ffmpeg'
  'opencv2'
  'gstreamer'
)
makedepends=(
  'cmake'
  'doxygen'
  'graphviz'
)
provides=('qarv')
conflicts=('qarv-git')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/AD-Vega/${pkgname}/archive/${pkgver}.tar.gz"
  "include-cstring.patch"
)
sha256sums=(
  'e5a9e9527111403d6f42167da97a64f14e586d4d7a95f965f755360c192dd97c'
  '775c0407039c6c84befb2b6ea388cf01f9af0d0c3f3c0907143a908dbe26caa4'
)

prepare() {
  cd "$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/include-cstring.patch"
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname-$pkgver"
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D OpenCV_DIR=/opt/opencv2/share/OpenCV
  )
  cmake "${cmake_options[@]}"
  cmake --build build --target all doc
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -d "$pkgdir/usr/share/doc/$pkgname/apidoc"
  cp -a build/apidoc/. "$pkgdir/usr/share/doc/$pkgname/apidoc/"
  cd $pkgname-$pkgver
  install -Dm644 README NEWS AUTHORS -t "$pkgdir/usr/share/doc/$pkgname"
}

